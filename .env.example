# Placeholders only - copy to .env in this folder (the project root) and fill in.
# Never commit .env.

# --- LLM (active extraction path: backend/app/services/ai_service.py) ---
ANTHROPIC_API_KEY=your-api-key
# Optional. Falls back to DEFAULT_CLAUDE_MODEL in ai_service.py when unset or empty.
CLAUDE_MODEL=claude-sonnet-5-5

# Optional confidence bands (CLAUDE.md section 5). Below CONF_EMPTY_BELOW the value is dropped;
# up to and including CONF_OK_ABOVE it is kept but shown in red for review. Defaults 50 / 99 -
# i.e. only a reading the model scored 100 passes without a red mark.
CONF_EMPTY_BELOW=50
CONF_OK_ABOVE=99

# --- Gemini / OCR (currently not in the active path) ---
MODEL_NAME=your-llm-model-name
GOOGLE_API_KEY=your-api-key
# Resolved relative to backend/ (see ocr_service.py).
OCR_CREDENTIALS_FILE=path/to/google-credentials.json

# --- Storage ---
# Optional. Defaults to <project root>/uploads.
UPLOADS_DIR=
