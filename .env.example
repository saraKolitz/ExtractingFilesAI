# Placeholders only - copy to .env in this folder (the project root) and fill in.
# Never commit .env.

# --- LLM (active extraction path: backend/app/services/ai_service.py) ---
ANTHROPIC_API_KEY=your-api-key
# Optional. Falls back to DEFAULT_CLAUDE_MODEL in ai_service.py when unset or empty.
CLAUDE_MODEL=claude-sonnet-5-5

# Optional confidence bands (CLAUDE.md section 5). Below CONF_EMPTY_BELOW the value is dropped;
# from there up to and including CONF_OK_ABOVE it is kept but flagged for review; only a score
# above CONF_OK_ABOVE passes clean. Defaults 15 / 70: 0-14 dropped (shown as NULL; the model scores a
# field it did not find 0), 15-70 kept and flagged, 71-100 clean.
CONF_EMPTY_BELOW=15
CONF_OK_ABOVE=70

# --- Gemini / OCR (currently not in the active path) ---
MODEL_NAME=your-llm-model-name
GOOGLE_API_KEY=your-api-key
# Resolved relative to backend/ (see ocr_service.py).
OCR_CREDENTIALS_FILE=path/to/google-credentials.json

# --- Storage ---
# Optional. Defaults to <project root>/uploads.
UPLOADS_DIR=

# Optional. Where the last five calibration runs are kept. Defaults to <project root>/data/calibration_runs.json.
CALIBRATION_FILE=

# Optional. SQLite file every export is saved to. Defaults to <project root>/data/commitments.db.
DB_FILE=

# Key required (header X-API-Key) to read saved records via GET /records. Leave empty and nobody can read them.
DB_API_KEY=

# Optional. Password Excel asks for when opening an exported file. Leave empty for an unprotected file.
EXCEL_PASSWORD=

# Turn a sideways or upside-down scan upright (for the model only) before extracting. 0 switches it off.
AUTO_ROTATE=1
